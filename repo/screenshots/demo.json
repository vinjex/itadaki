    {
      "key": "tsukune",
      "image": "tsukune.jpg",
      "recipe": {
        "language": "en",
        "title": "Tsukune",
        "description": "Juicy chicken meatballs glazed in a sweet soy sauce, the classic of every yakitori bar. Shape them on skewers or cook them as patties in a pan.",
        "servings": 4,
        "prep_minutes": 15,
        "cook_minutes": 15,
        "tags": ["japanese", "main"],
        "ingredients": [
          {"ingredient_id": "ground_chicken", "quantity": 500, "unit_id": "g"},
          {"ingredient_id": "green_onion", "quantity": 1, "note": "finely chopped"},
          {"ingredient_id": "egg", "quantity": 1},
          {"ingredient_id": "ginger", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "potato_starch", "quantity": 1, "unit_id": "tbsp"},
          {"ingredient_id": "salt", "unit_id": "pinch"},
          {"ingredient_id": "oil", "quantity": 1, "unit_id": "tbsp"},
          {"ingredient_id": "soy_sauce", "quantity": 3, "unit_id": "tbsp", "section": "Glaze"},
          {"ingredient_id": "mirin", "quantity": 3, "unit_id": "tbsp", "section": "Glaze"},
          {"ingredient_id": "sake", "quantity": 2, "unit_id": "tbsp", "section": "Glaze"},
          {"ingredient_id": "sugar", "quantity": 1, "unit_id": "tbsp", "section": "Glaze"}
        ],
        "steps": [
          {"text": "Put the chicken, green onion, egg, ginger, potato starch and salt in a bowl.", "section": "Meatballs"},
          {"text": "Knead by hand for about two minutes, until the mixture turns sticky and pale.", "section": "Meatballs"},
          {"text": "With wet hands, shape twelve small oval patties.", "section": "Meatballs"},
          {"text": "Stir the soy sauce, mirin, sake and sugar together until the sugar dissolves.", "section": "Glaze"},
          {"text": "Heat the oil in a frying pan over medium heat and brown the patties for three minutes on each side.", "section": "Cooking"},
          {"text": "Cover and cook for four more minutes on low heat, until cooked through.", "section": "Cooking"},
          {"text": "Pour in the glaze and turn the patties until it thickens and coats them.", "section": "Cooking"}
        ],
        "notes": "Serve with an egg yolk for dipping."
      }
    },
    {
      "key": "miso",
      "image": "miso-soup.jpg",
      "recipe": {
        "language": "en",
        "title": "Miso soup",
        "description": "A five-minute everyday soup with tofu and wakame.",
        "servings": 2,
        "total_minutes": 10,
        "tags": ["japanese", "soup", "quick"],
        "ingredients": [
          {"ingredient_id": "dashi", "quantity": 400, "unit_id": "ml"},
          {"ingredient_id": "miso", "quantity": 2, "unit_id": "tbsp"},
          {"ingredient_id": "tofu", "quantity": 150, "unit_id": "g", "note": "cut into cubes"},
          {"ingredient_id": "wakame", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "green_onion", "quantity": 0.5, "note": "thinly sliced"}
        ],
        "steps": [
          {"text": "Bring the dashi to a simmer and add the tofu and wakame."},
          {"text": "Turn off the heat and dissolve the miso in a ladle of the soup, then stir it back in."},
          {"text": "Serve at once, topped with the green onion."}
        ]
      },
      "translations": [
        {
          "language": "ja",
          "title": "味噌汁",
          "description": "豆腐とわかめの、5分でできる毎日の味噌汁。",
          "servings": 2,
          "total_minutes": 10,
          "ingredients": [
            {"ingredient_id": "dashi", "quantity": 400, "unit_id": "ml"},
            {"ingredient_id": "miso", "quantity": 2, "unit_id": "tbsp"},
            {"ingredient_id": "tofu", "quantity": 150, "unit_id": "g", "note": "さいの目切り"},
            {"ingredient_id": "wakame", "quantity": 1, "unit_id": "tsp"},
            {"ingredient_id": "green_onion", "quantity": 0.5, "note": "小口切り"}
          ],
          "steps": [
            {"text": "だし汁を温め、豆腐とわかめを入れる。"},
            {"text": "火を止め、お玉に取った汁で味噌を溶いて戻し入れる。"},
            {"text": "器に盛り、長ねぎをのせてすぐにいただく。"}
          ]
        }
      ]
    },
    {
      "key": "ajitama",
      "image": "ajitama.jpg",
      "recipe": {
        "language": "en",
        "title": "Marinated soft-boiled eggs",
        "description": "Jammy eggs soaked overnight in soy sauce and mirin, for ramen or a lunch box.",
        "servings": 4,
        "cook_minutes": 7,
        "tags": ["japanese", "side"],
        "ingredients": [
          {"ingredient_id": "egg", "quantity": 4},
          {"ingredient_id": "soy_sauce", "quantity": 4, "unit_id": "tbsp"},
          {"ingredient_id": "mirin", "quantity": 4, "unit_id": "tbsp"},
          {"ingredient_id": "water", "quantity": 4, "unit_id": "tbsp"}
        ],
        "steps": [
          {"text": "Lower the cold eggs into boiling water and cook for six and a half minutes."},
          {"text": "Cool them in ice water, then peel."},
          {"text": "Mix the soy sauce, mirin and water in a bag, add the eggs and chill overnight."}
        ]
      }
    },
    {
      "key": "goma_ae",
      "image": "goma-ae.jpg",
      "recipe": {
        "language": "en",
        "title": "Spinach with sesame dressing",
        "description": "Blanched spinach tossed in a sweet, nutty sesame sauce.",
        "servings": 2,
        "total_minutes": 10,
        "tags": ["japanese", "side", "quick"],
        "ingredients": [
          {"ingredient_id": "spinach", "quantity": 200, "unit_id": "g"},
          {"ingredient_id": "sesame", "quantity": 2, "unit_id": "tbsp"},
          {"ingredient_id": "soy_sauce", "quantity": 1, "unit_id": "tbsp"},
          {"ingredient_id": "sugar", "quantity": 1, "unit_id": "tsp"}
        ],
        "steps": [
          {"text": "Blanch the spinach for one minute, cool it in cold water and squeeze it dry."},
          {"text": "Grind the sesame seeds, then mix in the soy sauce and sugar."},
          {"text": "Cut the spinach into short lengths and toss it with the dressing."}
        ]
      }
    }
  ]
