      "recipe": {
        "language": "en",
        "title": "Thai green curry",
        "description": "Chicken, mushrooms and green beans in a fragrant coconut sauce, finished with Thai basil.",
        "yield_quantity": 4,
        "prep_minutes": 15,
        "cook_minutes": 20,
        "tags": ["thai", "main"],
        "ingredients": [
