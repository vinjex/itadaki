    {
      "key": "mousse",
      "image": "chocolate-mousse.jpg",
      "recipe": {
        "language": "en",
        "title": "Chocolate mousse",
        "description": "Airy dark chocolate mousse, made the night before.",
        "yield_quantity": 4,
        "prep_minutes": 20,
        "total_minutes": 260,
        "tags": ["french", "dessert"],
        "ingredients": [
          {"ingredient_id": "dark_chocolate", "quantity": 150, "unit_id": "g"},
          {"ingredient_id": "butter", "quantity": 20, "unit_id": "g"},
          {"ingredient_id": "egg", "quantity": 4, "note": "separated"},
          {"ingredient_id": "sugar", "quantity": 2, "unit_id": "tbsp"},
          {"ingredient_id": "cream", "quantity": 100, "unit_id": "ml"},
          {"ingredient_id": "salt", "unit_id": "pinch"}
        ],
        "steps": [
          {"text": "Melt the chocolate and butter over barely simmering water, then let it cool a little."},
          {"text": "Stir in the yolks one at a time."},
          {"text": "Whip the cream to soft peaks."},
          {"text": "Whisk the whites with the salt to soft peaks, then add the sugar and whisk until glossy."},
          {"text": "Fold the cream into the chocolate, then the whites in two batches, as gently as you can."},
          {"text": "Spoon into glasses and chill for at least four hours."}
        ]
      }
    }
