    {
      "key": "ratatouille",
      "image": "ratatouille.jpg",
      "recipe": {
        "language": "en",
        "title": "Ratatouille",
        "description": "Summer vegetables from Provence, each browned on its own, then slowly stewed together.",
        "yield_quantity": 4,
        "prep_minutes": 25,
        "cook_minutes": 50,
        "tags": ["french", "main", "vegetarian"],
        "ingredients": [
          {"ingredient_id": "eggplant", "quantity": 1},
          {"ingredient_id": "zucchini", "quantity": 2},
          {"ingredient_id": "bell_pepper", "quantity": 2},
          {"ingredient_id": "onion", "quantity": 1},
          {"ingredient_id": "garlic", "quantity": 3, "unit_id": "clove"},
          {"ingredient_id": "tomato", "quantity": 4},
          {"ingredient_id": "olive_oil", "quantity": 4, "unit_id": "tbsp"},
          {"ingredient_id": "thyme", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "salt", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "black_pepper", "unit_id": "pinch"},
          {"ingredient_id": "parsley", "note": "to serve"}
        ],
        "steps": [
          {"text": "Cut the eggplant, zucchini and peppers into 2 cm pieces. Slice the onion and chop the garlic and tomatoes.", "section": "Prep"},
          {"text": "Brown the eggplant in a tablespoon of oil for six minutes and set it aside.", "section": "Cooking"},
          {"text": "Do the same with the zucchini, then the peppers, each with a little oil.", "section": "Cooking"},
          {"text": "Cook the onion in the remaining oil for eight minutes, then add the garlic for a minute.", "section": "Cooking"},
          {"text": "Add the tomatoes, thyme, salt and pepper and simmer for ten minutes.", "section": "Cooking"},
          {"text": "Return all the vegetables, cover and simmer gently for 20 minutes.", "section": "Cooking"},
          {"text": "Rest for ten minutes and sprinkle with parsley. It is even better the next day.", "section": "Serving"}
        ],
        "notes": "Cooking each vegetable on its own keeps them from turning to mush."
      }
    },
    {
      "key": "ajitama",
      "image": "ajitama.jpg",
      "recipe": {
        "language": "en",
        "title": "Marinated soft-boiled eggs",
        "description": "Jammy eggs soaked overnight in soy sauce and mirin, for ramen or a lunch box.",
        "yield_quantity": 4,
        "cook_minutes": 7,
        "tags": ["japanese", "side", "vegetarian"],
        "ingredients": [
