    {
      "key": "shakshuka",
      "image": "shakshuka.jpg",
      "recipe": {
        "language": "en",
        "title": "Shakshuka",
        "description": "Eggs gently poached in a spiced tomato and pepper sauce, served straight from the pan.",
        "yield_quantity": 2,
        "prep_minutes": 10,
        "cook_minutes": 25,
        "tags": ["middle_eastern", "breakfast", "vegetarian"],
        "ingredients": [
          {"ingredient_id": "olive_oil", "quantity": 2, "unit_id": "tbsp"},
          {"ingredient_id": "onion", "quantity": 1, "note": "sliced"},
          {"ingredient_id": "bell_pepper", "quantity": 1, "note": "sliced"},
          {"ingredient_id": "garlic", "quantity": 2, "unit_id": "clove", "note": "chopped"},
          {"ingredient_id": "cumin", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "paprika", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "canned_tomatoes", "quantity": 400, "unit_id": "g"},
          {"ingredient_id": "salt", "unit_id": "pinch"},
          {"ingredient_id": "egg", "quantity": 4},
          {"ingredient_id": "feta", "quantity": 50, "unit_id": "g", "note": "crumbled"},
          {"ingredient_id": "parsley", "note": "chopped"}
        ],
        "steps": [
          {"text": "Heat the oil in a wide frying pan and cook the onion and pepper for eight minutes, until soft."},
          {"text": "Add the garlic, cumin and paprika and stir for a minute."},
          {"text": "Add the tomatoes and salt and simmer for ten minutes, until thick."},
          {"text": "Make four hollows, crack an egg into each, cover and cook for six minutes, until the whites set."},
          {"text": "Top with the feta and parsley and serve from the pan, with bread."}
        ]
      },
      "translations": [
        {
          "language": "ja",
          "title": "シャクシュカ",
          "description": "スパイスを効かせたトマトとパプリカのソースで卵を煮込む、中東の朝ごはん。フライパンごと食卓へ。",
          "yield_quantity": 2,
          "prep_minutes": 10,
          "cook_minutes": 25,
          "ingredients": [
            {"ingredient_id": "olive_oil", "quantity": 2, "unit_id": "tbsp"},
            {"ingredient_id": "onion", "quantity": 1, "note": "薄切り"},
            {"ingredient_id": "bell_pepper", "quantity": 1, "note": "細切り"},
            {"ingredient_id": "garlic", "quantity": 2, "unit_id": "clove", "note": "みじん切り"},
            {"ingredient_id": "cumin", "quantity": 1, "unit_id": "tsp"},
            {"ingredient_id": "paprika", "quantity": 1, "unit_id": "tsp"},
            {"ingredient_id": "canned_tomatoes", "quantity": 400, "unit_id": "g"},
            {"ingredient_id": "salt", "unit_id": "pinch"},
            {"ingredient_id": "egg", "quantity": 4},
            {"ingredient_id": "feta", "quantity": 50, "unit_id": "g", "note": "崩す"},
            {"ingredient_id": "parsley", "note": "刻む"}
          ],
          "steps": [
            {"text": "広めのフライパンに油を熱し、玉ねぎとパプリカをしんなりするまで8分ほど炒める。"},
            {"text": "にんにく、クミン、パプリカパウダーを加えて1分炒める。"},
            {"text": "トマト缶と塩を加え、とろみがつくまで10分煮る。"},
            {"text": "くぼみを4か所作って卵を割り入れ、ふたをして白身が固まるまで6分煮る。"},
            {"text": "フェタチーズとパセリを散らし、パンを添えてフライパンごと出す。"}
          ]
        }
      ],
      "update": {
        "steps": [
          {"text": "Heat the oil in a wide frying pan and cook the onion and pepper for eight minutes, until soft."},
          {"text": "Add the garlic, cumin and paprika and stir for a minute."},
          {"text": "Add the tomatoes and salt and simmer for ten minutes, until thick."},
          {"text": "Make four hollows, crack an egg into each, cover and cook for five to eight minutes, until the whites set but the yolks are still runny."},
          {"text": "Top with the feta and parsley and serve from the pan, with bread."}
        ]
      }
    },
    {
      "key": "tsukune",
      "image": "tsukune.jpg",
      "recipe": {
        "language": "en",
        "title": "Tsukune",
        "description": "Juicy chicken meatballs glazed in a sweet soy sauce, the classic of every yakitori bar. Shape them on skewers or cook them as patties in a pan.",
        "yield_quantity": 4,
        "prep_minutes": 15,
        "cook_minutes": 15,
        "tags": ["japanese", "main"],
        "ingredients": [
          {"ingredient_id": "ground_chicken", "quantity": 500, "unit_id": "g"},
          {"ingredient_id": "green_onion", "quantity": 1, "note": "finely chopped"},
          {"ingredient_id": "egg", "quantity": 1},
          {"ingredient_id": "ginger", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "potato_starch", "quantity": 1, "unit_id": "tbsp"},
          {"ingredient_id": "salt", "unit_id": "pinch"},
          {"ingredient_id": "oil", "quantity": 1, "unit_id": "tbsp"},
          {"ingredient_id": "soy_sauce", "quantity": 3, "unit_id": "tbsp", "section": "Glaze"},
          {"ingredient_id": "mirin", "quantity": 3, "unit_id": "tbsp", "section": "Glaze"},
          {"ingredient_id": "sake", "quantity": 2, "unit_id": "tbsp", "section": "Glaze"},
          {"ingredient_id": "sugar", "quantity": 1, "unit_id": "tbsp", "section": "Glaze"}
        ],
        "steps": [
          {"text": "Put the chicken, green onion, egg, ginger, potato starch and salt in a bowl.", "section": "Meatballs"},
          {"text": "Knead by hand for about two minutes, until the mixture turns sticky and pale.", "section": "Meatballs"},
          {"text": "With wet hands, shape twelve small oval patties.", "section": "Meatballs"},
          {"text": "Stir the soy sauce, mirin, sake and sugar together until the sugar dissolves.", "section": "Glaze"},
          {"text": "Heat the oil in a frying pan over medium heat and brown the patties for three minutes on each side.", "section": "Cooking"},
          {"text": "Cover and cook for four more minutes on low heat, until cooked through.", "section": "Cooking"},
          {"text": "Pour in the glaze and turn the patties until it thickens and coats them.", "section": "Cooking"}
        ],
        "notes": "Serve with an egg yolk for dipping."
      },
      "translations": [
        {
          "language": "ja",
          "title": "つくね",
          "description": "甘辛いたれをからめた、ジューシーな鶏つくね。焼き鳥屋の定番を、串に刺しても、フライパンで焼いても。",
          "yield_quantity": 4,
          "prep_minutes": 15,
          "cook_minutes": 15,
          "ingredients": [
            {"ingredient_id": "ground_chicken", "quantity": 500, "unit_id": "g"},
            {"ingredient_id": "green_onion", "quantity": 1, "note": "みじん切り"},
            {"ingredient_id": "egg", "quantity": 1},
            {"ingredient_id": "ginger", "quantity": 1, "unit_id": "tsp"},
            {"ingredient_id": "potato_starch", "quantity": 1, "unit_id": "tbsp"},
            {"ingredient_id": "salt", "unit_id": "pinch"},
            {"ingredient_id": "oil", "quantity": 1, "unit_id": "tbsp"},
            {"ingredient_id": "soy_sauce", "quantity": 3, "unit_id": "tbsp", "section": "たれ"},
            {"ingredient_id": "mirin", "quantity": 3, "unit_id": "tbsp", "section": "たれ"},
            {"ingredient_id": "sake", "quantity": 2, "unit_id": "tbsp", "section": "たれ"},
            {"ingredient_id": "sugar", "quantity": 1, "unit_id": "tbsp", "section": "たれ"}
          ],
          "steps": [
            {"text": "ボウルに鶏ひき肉、長ねぎ、卵、生姜、片栗粉、塩を入れる。", "section": "肉だね"},
            {"text": "粘りが出て白っぽくなるまで、2分ほど手でこねる。", "section": "肉だね"},
            {"text": "手を水でぬらし、小判形に12個まとめる。", "section": "肉だね"},
            {"text": "醤油、みりん、酒、砂糖を、砂糖が溶けるまで混ぜる。", "section": "たれ"},
            {"text": "フライパンに油を中火で熱し、両面を3分ずつ焼く。", "section": "焼く"},
            {"text": "ふたをして弱火で4分、中まで火を通す。", "section": "焼く"},
            {"text": "たれを加え、とろみがついてからむまで返しながら煮詰める。", "section": "焼く"}
          ],
          "notes": "卵黄を添えて、つけながらどうぞ。"
        }
      ]
    },
    {
      "key": "cacio_e_pepe",
      "image": "cacio-e-pepe.jpg",
      "recipe": {
        "language": "en",
        "title": "Cacio e pepe",
        "description": "Roman spaghetti with nothing but pecorino, black pepper and the pasta's own starchy water.",
        "yield_quantity": 2,
        "total_minutes": 20,
        "tags": ["italian", "main", "quick", "vegetarian"],
        "ingredients": [
          {"ingredient_id": "spaghetti", "quantity": 200, "unit_id": "g"},
          {"ingredient_id": "pecorino", "quantity": 80, "unit_id": "g", "note": "finely grated"},
          {"ingredient_id": "black_pepper", "quantity": 2, "unit_id": "tsp", "note": "freshly ground"},
          {"ingredient_id": "salt", "note": "for the pasta water"}
        ],
        "steps": [
          {"text": "Cook the spaghetti in lightly salted water until just short of al dente, and keep a mug of the cooking water."},
          {"text": "Toast the pepper in a dry frying pan for a minute, then add a ladle of the pasta water."},
          {"text": "Mix the pecorino with a few spoons of warm, not hot, pasta water into a smooth paste."},
          {"text": "Move the spaghetti into the pan and toss it in the peppery water for a minute."},
          {"text": "Off the heat, add the cheese paste and toss quickly, loosening with more pasta water until creamy."}
        ],
        "notes": "If the sauce turns lumpy, the pan was too hot: let it cool for a moment before adding the cheese."
      }
    },
    {
      "key": "guacamole",
      "image": "guacamole.jpg",
      "recipe": {
        "language": "en",
        "title": "Guacamole",
        "description": "Chunky avocado dip with lime, chili and cilantro.",
        "yield_quantity": 4,
        "total_minutes": 10,
        "tags": ["mexican", "side", "quick", "vegetarian"],
        "ingredients": [
          {"ingredient_id": "avocado", "quantity": 3},
          {"ingredient_id": "lime", "quantity": 1, "note": "juiced"},
          {"ingredient_id": "salt", "quantity": 0.5, "unit_id": "tsp"},
          {"ingredient_id": "red_onion", "quantity": 0.25, "note": "finely chopped"},
          {"ingredient_id": "tomato", "quantity": 1, "note": "seeded and diced"},
          {"ingredient_id": "chili", "quantity": 1, "note": "minced"},
          {"ingredient_id": "cilantro", "note": "a handful, chopped"}
        ],
        "steps": [
          {"text": "Halve the avocados, scoop them into a bowl and mash coarsely with a fork."},
          {"text": "Stir in the lime juice and salt at once, so the avocado stays green."},
          {"text": "Fold in the onion, tomato, chili and cilantro, then taste and adjust the lime and salt."}
        ]
      }
    },
    {
      "key": "katsudon",
      "image": "katsudon.jpg",
      "recipe": {
        "language": "ja",
        "title": "カツ丼",
        "description": "揚げたてのとんかつを玉ねぎと甘辛いだしで煮て、卵でとじてご飯にのせる。",
        "yield_quantity": 2,
        "prep_minutes": 15,
        "cook_minutes": 20,
        "tags": ["japanese", "main"],
        "ingredients": [
          {"ingredient_id": "pork_loin", "quantity": 2, "note": "とんかつ用"},
          {"ingredient_id": "salt", "unit_id": "pinch"},
          {"ingredient_id": "flour", "quantity": 2, "unit_id": "tbsp", "section": "衣"},
          {"ingredient_id": "egg", "quantity": 1, "section": "衣"},
          {"ingredient_id": "panko", "quantity": 40, "unit_id": "g", "section": "衣"},
          {"ingredient_id": "oil", "note": "揚げ油、適量", "section": "衣"},
          {"ingredient_id": "dashi", "quantity": 150, "unit_id": "ml", "section": "煮汁"},
          {"ingredient_id": "soy_sauce", "quantity": 2, "unit_id": "tbsp", "section": "煮汁"},
          {"ingredient_id": "mirin", "quantity": 2, "unit_id": "tbsp", "section": "煮汁"},
          {"ingredient_id": "sugar", "quantity": 1, "unit_id": "tsp", "section": "煮汁"},
          {"ingredient_id": "onion", "quantity": 0.5, "note": "薄切り", "section": "仕上げ"},
          {"ingredient_id": "egg", "quantity": 3, "note": "溶きほぐす", "section": "仕上げ"},
          {"ingredient_id": "rice", "quantity": 400, "unit_id": "g", "section": "仕上げ"},
          {"ingredient_id": "mitsuba", "note": "飾り用", "section": "仕上げ"}
        ],
        "steps": [
          {"text": "豚肉の筋を数か所切り、両面に塩をふる。", "section": "揚げる"},
          {"text": "小麦粉、溶き卵、パン粉の順に衣をつける。", "section": "揚げる"},
          {"text": "170℃の油で両面を3分ずつ、きつね色になるまで揚げる。油を切り、食べやすく切る。", "section": "揚げる"},
          {"text": "小さめのフライパンに煮汁と玉ねぎを入れ、玉ねぎがしんなりするまで3分煮る。", "section": "とじる"},
          {"text": "カツをのせて溶き卵を回し入れ、ふたをして半熟になるまで1分煮る。", "section": "とじる"},
          {"text": "ご飯にのせ、三つ葉を散らす。", "section": "とじる"}
        ],
        "notes": "前の日のとんかつで作ってもおいしい。"
      },
      "translations": [
        {
          "language": "en",
          "title": "Katsudon",
          "description": "A freshly fried pork cutlet simmered with onion in sweet soy dashi, set with egg and served over rice.",
          "yield_quantity": 2,
          "prep_minutes": 15,
          "cook_minutes": 20,
          "ingredients": [
            {"ingredient_id": "pork_loin", "quantity": 2, "note": "cutlets"},
            {"ingredient_id": "salt", "unit_id": "pinch"},
            {"ingredient_id": "flour", "quantity": 2, "unit_id": "tbsp", "section": "Coating"},
            {"ingredient_id": "egg", "quantity": 1, "section": "Coating"},
            {"ingredient_id": "panko", "quantity": 40, "unit_id": "g", "section": "Coating"},
            {"ingredient_id": "oil", "note": "for frying", "section": "Coating"},
            {"ingredient_id": "dashi", "quantity": 150, "unit_id": "ml", "section": "Simmering sauce"},
            {"ingredient_id": "soy_sauce", "quantity": 2, "unit_id": "tbsp", "section": "Simmering sauce"},
            {"ingredient_id": "mirin", "quantity": 2, "unit_id": "tbsp", "section": "Simmering sauce"},
            {"ingredient_id": "sugar", "quantity": 1, "unit_id": "tsp", "section": "Simmering sauce"},
            {"ingredient_id": "onion", "quantity": 0.5, "note": "thinly sliced", "section": "To finish"},
            {"ingredient_id": "egg", "quantity": 3, "note": "lightly beaten", "section": "To finish"},
            {"ingredient_id": "rice", "quantity": 400, "unit_id": "g", "section": "To finish"},
            {"ingredient_id": "mitsuba", "note": "to garnish", "section": "To finish"}
          ],
          "steps": [
            {"text": "Cut through the fat on the pork in a few places and salt both sides.", "section": "Frying"},
            {"text": "Coat in flour, then beaten egg, then panko.", "section": "Frying"},
            {"text": "Fry at 170 °C for three minutes on each side, until golden. Drain and slice.", "section": "Frying"},
            {"text": "Simmer the sauce and onion in a small frying pan for three minutes, until the onion softens.", "section": "Finishing"},
            {"text": "Lay the cutlet on top, pour the egg around it, cover and cook for one minute, until just set.", "section": "Finishing"},
            {"text": "Slide it onto the rice and scatter the mitsuba on top.", "section": "Finishing"}
          ],
          "notes": "Leftover tonkatsu from the day before works just as well."
        }
      ]
    },
    {
      "key": "dal",
      "image": "dal.jpg",
      "recipe": {
        "language": "en",
        "title": "Red lentil dal",
        "description": "Creamy lentils finished with a sizzling tadka of cumin, garlic and tomato.",
        "yield_quantity": 4,
        "prep_minutes": 10,
        "cook_minutes": 35,
        "tags": ["indian", "main", "vegetarian"],
        "ingredients": [
          {"ingredient_id": "red_lentils", "quantity": 250, "unit_id": "g", "note": "rinsed"},
          {"ingredient_id": "water", "quantity": 1, "unit_id": "l"},
          {"ingredient_id": "turmeric", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "salt", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "butter", "quantity": 2, "unit_id": "tbsp", "section": "Tadka"},
          {"ingredient_id": "cumin_seeds", "quantity": 1, "unit_id": "tsp", "section": "Tadka"},
          {"ingredient_id": "onion", "quantity": 1, "note": "finely chopped", "section": "Tadka"},
          {"ingredient_id": "garlic", "quantity": 3, "unit_id": "clove", "note": "sliced", "section": "Tadka"},
          {"ingredient_id": "ginger", "quantity": 1, "unit_id": "tsp", "section": "Tadka"},
          {"ingredient_id": "chili", "quantity": 1, "note": "slit lengthwise", "section": "Tadka"},
          {"ingredient_id": "tomato", "quantity": 2, "note": "chopped", "section": "Tadka"},
          {"ingredient_id": "garam_masala", "quantity": 0.5, "unit_id": "tsp", "section": "Tadka"},
          {"ingredient_id": "cilantro", "note": "to serve", "section": "Tadka"}
        ],
        "steps": [
          {"text": "Put the lentils, water and turmeric in a pot, bring to a boil and skim off the foam.", "section": "Lentils"},
          {"text": "Simmer half covered for 25 minutes, stirring now and then, until the lentils fall apart. Season with the salt.", "section": "Lentils"},
          {"text": "Melt the butter in a frying pan and fry the cumin seeds until they crackle.", "section": "Tadka"},
          {"text": "Add the onion and cook for eight minutes, until golden.", "section": "Tadka"},
          {"text": "Add the garlic, ginger and chili for a minute, then the tomatoes until they soften.", "section": "Tadka"},
          {"text": "Stir in the garam masala and pour everything into the lentils.", "section": "Tadka"},
          {"text": "Simmer for two more minutes and serve topped with cilantro.", "section": "Tadka"}
        ]
      }
    },
    {
      "key": "greek_salad",
      "image": "greek-salad.jpg",
      "recipe": {
        "language": "en",
        "title": "Greek salad",
        "description": "Ripe tomatoes, cucumber and olives under a whole slab of feta.",
        "yield_quantity": 2,
        "total_minutes": 10,
        "tags": ["greek", "side", "quick", "vegetarian"],
        "ingredients": [
          {"ingredient_id": "tomato", "quantity": 3, "note": "cut into wedges"},
          {"ingredient_id": "cucumber", "quantity": 1, "note": "thickly sliced"},
          {"ingredient_id": "red_onion", "quantity": 0.5, "note": "thinly sliced"},
          {"ingredient_id": "olives", "quantity": 12},
          {"ingredient_id": "feta", "quantity": 150, "unit_id": "g", "note": "in one piece"},
          {"ingredient_id": "oregano", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "olive_oil", "quantity": 3, "unit_id": "tbsp"},
          {"ingredient_id": "red_wine_vinegar", "quantity": 1, "unit_id": "tbsp"},
          {"ingredient_id": "salt", "unit_id": "pinch"}
        ],
        "steps": [
          {"text": "Put the tomatoes, cucumber, onion and olives in a wide bowl and season with salt."},
          {"text": "Whisk the oil and vinegar and pour it over."},
          {"text": "Lay the feta on top in one piece, sprinkle with oregano and drizzle with a little more oil."}
        ]
      }
    },
    {
      "key": "miso",
      "image": "miso-soup.jpg",
      "recipe": {
        "language": "en",
        "title": "Miso soup",
        "description": "A five-minute everyday soup with tofu and wakame.",
        "yield_quantity": 2,
        "total_minutes": 10,
        "tags": ["japanese", "soup", "quick", "vegetarian"],
        "ingredients": [
          {"ingredient_id": "dashi", "quantity": 400, "unit_id": "ml"},
          {"ingredient_id": "miso", "quantity": 2, "unit_id": "tbsp"},
          {"ingredient_id": "tofu", "quantity": 150, "unit_id": "g", "note": "cut into cubes"},
          {"ingredient_id": "wakame", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "green_onion", "quantity": 0.5, "note": "thinly sliced"}
        ],
        "steps": [
          {"text": "Bring the dashi to a simmer and add the tofu and wakame."},
          {"text": "Turn off the heat and dissolve the miso in a ladle of the soup, then stir it back in."},
          {"text": "Serve at once, topped with the green onion."}
        ]
      },
      "translations": [
        {
          "language": "ja",
          "title": "味噌汁",
          "description": "豆腐とわかめの、5分でできる毎日の味噌汁。",
          "yield_quantity": 2,
          "total_minutes": 10,
          "ingredients": [
            {"ingredient_id": "dashi", "quantity": 400, "unit_id": "ml"},
            {"ingredient_id": "miso", "quantity": 2, "unit_id": "tbsp"},
            {"ingredient_id": "tofu", "quantity": 150, "unit_id": "g", "note": "さいの目切り"},
            {"ingredient_id": "wakame", "quantity": 1, "unit_id": "tsp"},
            {"ingredient_id": "green_onion", "quantity": 0.5, "note": "小口切り"}
          ],
          "steps": [
            {"text": "だし汁を温め、豆腐とわかめを入れる。"},
            {"text": "火を止め、お玉に取った汁で味噌を溶いて戻し入れる。"},
            {"text": "器に盛り、長ねぎをのせてすぐにいただく。"}
          ]
        }
      ]
    },
    {
      "key": "banana_bread",
      "image": "banana-bread.jpg",
      "recipe": {
        "language": "en",
        "title": "Banana bread",
        "description": "A moist, lightly sweet loaf that turns overripe bananas into breakfast.",
        "yield_quantity": 1,
        "yield_unit_id": "loaf",
        "prep_minutes": 15,
        "cook_minutes": 60,
        "tags": ["baking", "breakfast", "dessert", "vegetarian"],
        "ingredients": [
          {"ingredient_id": "banana", "quantity": 3, "note": "very ripe"},
          {"ingredient_id": "butter", "quantity": 80, "unit_id": "g", "note": "melted"},
          {"ingredient_id": "brown_sugar", "quantity": 120, "unit_id": "g"},
          {"ingredient_id": "egg", "quantity": 1},
          {"ingredient_id": "flour", "quantity": 190, "unit_id": "g"},
          {"ingredient_id": "baking_soda", "quantity": 1, "unit_id": "tsp"},
          {"ingredient_id": "salt", "unit_id": "pinch"},
          {"ingredient_id": "walnuts", "quantity": 60, "unit_id": "g", "note": "chopped"}
        ],
        "steps": [
          {"text": "Heat the oven to 175 °C and line a loaf pan with baking paper."},
          {"text": "Mash the bananas, then stir in the melted butter, sugar and egg."},
          {"text": "Sift in the flour, baking soda and salt, and fold until just combined."},
          {"text": "Fold in the walnuts and scrape the batter into the pan."},
          {"text": "Bake for 55 to 65 minutes, until a skewer comes out clean, then cool in the pan for ten minutes."}
        ],
        "notes": "The darker the bananas, the sweeter the bread."
      }
    },
    {
      "key": "green_curry",
